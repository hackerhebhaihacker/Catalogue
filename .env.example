# ─────────────────────────────────────────────────────────────────────────────
#  ENVIRONMENT VARIABLES — Copy this file to .env.local and fill in the values
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# New publishable key (sb_publishable_...) — preferred
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Legacy anon key — used as fallback if publishable key is not set
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Service role key — SERVER ONLY, never expose in browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Resend (email) ────────────────────────────────────────────────────────────
# Create a free account at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# The domain you've verified in Resend (or use resend.dev for testing)
RESEND_DOMAIN=yourdomain.com

# ── Admin ────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=contact@yourdomain.com
